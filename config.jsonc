{
  // Which version of this file it is: the server adds what a newer Satellite brings, keeping your own settings
  "configVersion": 3,
  // What the web map may show, for everyone who opens the page. The game always reports these. The page starts
  // with enemy PMCs, scavs, guards and bosses turned off, and each viewer can turn them on for their own page.
  // false: the server never passes that kind on, so no page can show it. Restart the server after a change.
  "markers": {
    "friendlyPlayers": true,
    "enemyPmcs": true,
    "scavs": true,
    // sniper scavs
    "snipers": true,
    // bosses' followers
    "guards": true,
    // the cultist priest and warriors
    "cultists": true,
    // Knight, Big Pipe and Birdeye
    "goons": true,
    "bosses": true,
    "raiders": true,
    "rogues": true,
    // none in the game yet: shown once a mod adds them
    "smugglers": true,
    // the BlackDiv mod's bots, Wedge among them
    "blackDivision": true,
    // the RUAFComeHome mod's soldiers (Manimal's Terminal brings them in too)
    "ruaf": true,
    // the RUAF remnant riflemen
    "ruafRemnant": true,
    // the UNTAR Go Home mod's soldiers
    "untar": true,
    // the ISB Special Forces mod's soldiers, their bosses among them
    "isb": true,
    // ISB's White Tusks: Firefly and those with her
    "isbWhiteTusks": true,
    // the arena fighters of an event (Bloodhounds), a mod's mercenaries, and Manimal's Combine
    "bloodhounds": true,
    "mercenaries": true,
    "combine": true,
    // the people living on Manimal's Terminal
    "civilians": true,
    // the infected (the zombie event)
    "infected": true,
    // every other bot: event and arena bots, a mod's own
    "otherAi": true,
    "corpses": true,
    "extracts": true,
    // transits to other locations
    "transits": true,
    // airdrop crates, coming down and landed (what's in them goes by "containerContents")
    "airdrops": true
  },
  // What else the map may show. false: the game doesn't send it and the server never passes it on.
  "layers": {
    // items lying about, quest items among them
    "looseLoot": true,
    // what's inside each container
    "containerContents": true,
    // doors, car trunks and safes a key opens, and the key each needs
    "locks": true,
    // power switches, levers and the like, and whether each is switched yet
    "switches": true,
    // where PMCs, scavs and bosses can spawn
    "spawnPoints": true,
    // what each bot is like and is up to: its difficulty, its SAIN personality, whether SAIN or ORBIT is deciding
    // for it, and whether ORBIT has it parked as a ghost
    "botDetails": true,
    // what each living bot wears and carries (a page shows it only once its "Bot loot" switch is turned on)
    "botLoot": true
  },
  // Raid history: each raid is recorded as it's played, to play back on the page's History tab.
  "history": {
    // false: no raid is recorded
    "record": true,
    // how many raids are kept: the oldest are deleted beyond this
    "keep": 30,
    // with COMET: what each bot chose and why, for the replay's Why tab (a few percent more per raid). false: not recorded
    "comet": true,
    // true: all of what COMET says, its settings and its reports of the whole raid too, for its debug views
    // (several times the size)
    "cometDebug": false,
    // the most COMET's decisions may take for one raid (MB): the rest of that raid's are left out
    "cometMb": 100
  },
  // The SPT server itself. Restart the server after a change.
  "server": {
    // true: SPT's "[Client Request] <address>" line is left out for the map's own requests, so they never fill the
    // server's window and log. Every other request (other mods', the game's own) is logged as SPT always does.
    // false: the map's requests are logged too.
    "quietLogs": true
  }
}
